{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "remotion preview src/remotion-index.ts",
    "build": "npm run generate-audio && vite build",
    "build:video": "npm run generate-audio && remotion render src/remotion-index.ts LiquidGlassPromo out/liquid-glass-promo.mp4 --codec=h264 --crf=16",
    "render": "npm run generate-audio && remotion render src/remotion-index.ts LiquidGlassPromo out/liquid-glass-promo.mp4 --codec=h264 --crf=16 --gl=angle",
    "preview": "vite preview",
    "generate-audio": "node scripts/generate-sfx.mjs",
    "test": "tsx --test src/utils/transitions.test.ts",
    "clean": "rm -rf dist server.js out",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@remotion/cli": "^4.0.540",
    "@remotion/player": "^4.0.540",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.540",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
